APP_NAME="SupportFlow Cloud"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local default is SQLite (zero-config). DB_DATABASE must be an ABSOLUTE path
# with forward slashes when quoted. For MySQL/MariaDB (XAMPP phpMyAdmin
# or production), set DB_CONNECTION=mysql and fill in the values below.
DB_CONNECTION=sqlite
DB_DATABASE="C:/xampp/htdocs/IT Support & Helpdesk SaaS/database/dev.sqlite"
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail: local development uses the log driver (see storage/logs/laravel.log).
# For real delivery set MAIL_MAILER=smtp and configure host/credentials.
# XAMPP note: use a real SMTP account or Mailpit; MercuryMail is not recommended.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe (optional — app works in manual-billing mode without these).
# Get test keys at https://dashboard.stripe.com/test/apikeys
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Mail bounce/complaint receiver shared secret (X-Mail-Signature header).
# Empty = /webhooks/mail refuses everything.
MAIL_WEBHOOK_SECRET=

# SSO driver: none (enterprise-gated; see docs/ENTERPRISE_IDENTITY.md).
SSO_DRIVER=none

# White-label branding overrides (see config/branding.php for full list).
BRAND_PRODUCT_NAME="SupportFlow Cloud"
BRAND_COMPANY_NAME="SupportFlow Ltd"
BRAND_COMPANY_ADDRESS="71 Shelton Street, London WC2H 9JQ, United Kingdom"
BRAND_COMPANY_EMAIL="hello@example.com"
BRAND_COMPANY_PHONE="+44 20 7946 0958"
BRAND_SUPPORT_EMAIL="support@example.com"
BRAND_DEFAULT_CURRENCY=GBP
BRAND_DEFAULT_TIMEZONE=Europe/London
BRAND_TRIAL_DAYS=14

# Set to true to seed clearly-labelled demo data (local only, never production).
SEED_DEMO_DATA=false

# Super-admin creation without interactive prompt:
# php artisan supportflow:superadmin (password via SF_SUPERADMIN_PASSWORD)
SF_SUPERADMIN_PASSWORD=
